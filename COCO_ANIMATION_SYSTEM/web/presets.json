{
  "format": "coco-presets",
  "version": 1,
  "presets": {
    "welcome": { "play": "comm_greet", "then": "idle_main", "scenario": "App opening: Coco welcomes the user with a wave." },
    "new_user": { "play": "comm_introduce", "then": "idle_main", "scenario": "New user: Coco introduces itself." },
    "returning_user": { "play": ["comm_greet", "emo_happy"], "then": "idle_main", "scenario": "Returning user: Coco welcomes the learner back." },
    "lesson_start": { "play": ["emo_excited", "comm_explain"], "scenario": "Lesson start: Coco introduces the activity enthusiastically." },
    "question": { "play": "comm_think", "scenario": "Question displayed: Coco looks at the question and thinks." },
    "answer_selected": { "play": "comm_wait", "scenario": "Answer selected: Coco waits for the check." },
    "correct": { "play": "edu_celebrate_correct", "then": "idle_main", "scenario": "Correct answer: Coco celebrates." },
    "incorrect": { "play": "comm_encourage", "then": "idle_main", "scenario": "Incorrect answer: a supportive reaction." },
    "show_correction": { "play": "edu_correct_answer", "then": "idle_main", "scenario": "After a mistake: Coco points to the right answer." },
    "lesson_complete": { "play": "rew_celebrate", "then": "idle_main", "scenario": "Lesson completed: celebration with stars and confetti." },
    "new_landmark": { "play": ["trv_fly_in", "trv_new_landmark"], "then": "trv_explore", "scenario": "New landmark: Coco arrives in explorer gear." },
    "explore": { "play": "trv_explore", "scenario": "Explore mode." },
    "vocabulary": { "play": "edu_present_word", "then": "edu_hold_card", "scenario": "Vocabulary: Coco presents a new word." },
    "pronunciation": { "play": "edu_pronounce", "scenario": "Pronunciation: listen and repeat." },
    "voice_listen": { "play": "comm_listen", "scenario": "Voice chat: the learner speaks." },
    "voice_think": { "play": "comm_thinking_dots", "scenario": "Voice chat: Coco prepares an answer." },
    "voice_talk": { "play": "comm_talk", "scenario": "Voice chat: Coco talks." },
    "ai_processing": { "play": "comm_thinking_dots", "scenario": "AI processing: Coco thinks while waiting." },
    "offline": { "play": "rx_offline", "scenario": "No internet: Coco is confused." },
    "empty_chat": { "play": "comm_wait", "scenario": "Empty chat: Coco waits patiently." },
    "daily_streak": { "play": "rew_streak", "then": "idle_main", "scenario": "Daily streak: Coco celebrates the achievement." },
    "level_up": { "play": "rew_level_up", "then": "idle_main", "scenario": "Level up." },
    "hint": { "play": "comm_idea", "then": "idle_main", "scenario": "A hint is available." },
    "goodbye": { "play": "comm_goodbye", "then": "idle_main", "scenario": "End of session." },
    "sleep": { "play": ["rx_fall_asleep", "idle_sleep"], "scenario": "App inactive for a long time." },
    "wake_up": { "play": "idle_wake_up", "then": "idle_main", "scenario": "Back after inactivity." },
    "idle": { "play": "idle_main", "scenario": "Default state." },
    "happy": { "play": "emo_happy", "then": "idle_main", "scenario": "Generic positive reaction." },
    "thinking": { "play": "comm_think", "scenario": "Generic thinking." },
    "celebrate": { "play": "rew_celebrate", "then": "idle_main", "scenario": "Generic celebration." },
    "listening": { "play": "comm_listen", "scenario": "Generic listening." }
  }
}
